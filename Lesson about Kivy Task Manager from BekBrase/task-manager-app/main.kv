MDFloatLayout:
    MDLabel:
        id: task_label
        halign: "center"
        markup: True
        text: "[b][u][size=48]Task Manager[/size][/u][/b]"
        pos_hint: {"y": 0.40}
    ScrollView:
        pos_hint: {"center_y": 0.5, "center_x": 0.5}
        size_hint: 0.9, 0.8
        MDList:
            id: container

    MDFabButton:
        theme_bg_color: "Custom"
        md_bg_color: "#f5c1b0"    
        
        theme_icon_color: "Custom"
        icon_color: "#0a0a0a"

        on_enter: self.md_bg_color = "#ff8800"
        on_leave: self.md_bg_color = "#f5c1b0"

        icon: "plus-thick"
        on_release: app.show_task_dialog()
        elevation_normal: 12
        pos_hint: {"x": 0.45, "y": 0.04}

<DialogContent>
    orientation: 'vertical'
    spacing: "10dp"
    size_hint: 1, None          
    height: "150dp"

    GridLayout:
        rows: 1
        # cols: 2
        spacing: "10dp"
#region MDTextField_var_1
        # MDTextField:
            # id: task_text
            # hint_text: "Add Task ..."
            # pos_hint: {"center_y": 0.4}
            # max_text_length: 50
            # on_text_validate: (app.add_task(task_text, date_text.text), app.close_dialog())
#endregion

        MDTextField:
            id: task_text
            mode: "outlined"
            size_hint_x: 0.85

            MDTextFieldHintText:
                text: "Add Task ..."

            MDTextFieldMaxLengthText:
                max_text_length: 50
  
        MDIconButton:
            icon: "calendar"
            on_release: root.show_date_picker()
            padding:"10dp"

    MDLabel:
        id: date_text
        spacing: "10dp"

    BoxLayout:
        orientation: 'horizontal'
        
        MDButton:
            style: "filled"
            on_release: (app.add_task(task_text, date_text.text), app.close_dialog())

            MDButtonText:
                text: "SAVE"    
                     
        MDButton:
            style: "text"
            on_release: app.close_dialog()

            MDButtonText:
                text: "CANCEL"      

