<Button>
    font_size: 32
    #Ширина і висота відносно нашого застосунку
    size_hint: (0.3,0.3)

<MyLayout>

    FloatLayout:
        #orientation: "horizontal"
        #orientation: "vertical"
        size: root.width, root.height


        Button:
            text: "Top-Left"
            #{"x","y", "top", "bottom", "left", "right"}
            #1=100%
            pos_hint: {"x":0, "top":1}

        Button:
            text: "Top-Right"
            pos_hint: {"x":0.7, "top":1}

        Button:
            text: "Center"
            pos_hint: {"x":0.35, "y":0.35}

        Button:
            text: "Bottom-Left"
            pos_hint: {"x":0, "top":0.3}

        Button:
            text: "Bottom-Right"
            pos_hint: {"x":0.7, "bottom":1}










