<MyLayout>
    BoxLayout:
        orientation: "vertical"
        size: root.width, root.height

        padding: 50
        spacing: 20

        Label:
            id: my_label
            text: "Hello world"
            font_size: 32

        Button:
            # text: "Hello"
            # font_size: 32
            size_hint: .18, .18
            pos_hint: {'center_x': .5}
            background_color: 0,0,0,0

            on_press: root.hello_on()
            on_release: root.hello_off()


            Image:
                id: my_image
                source: "../images/jungle-canopy-image.webp"
                center_x: self.parent.center_x
                center_y: self.parent.center_y










