#:import get_color_from_hex kivy.utils.get_color_from_hex
Screen:
    MDCard:
        size_hint: None, None
        size: 300, 400
        pos_hint: {"center_x": 0.5, "center_y": 0.5 }
        elevation: 10
        padding: 25
        spacing: 25
        orientation: 'vertical'


        md_bg_color: get_color_from_hex("#2F2F2F")
#------------------------------------------------------------------- label Welcome        
        MDLabel:
            id: welcome_label
            text: 'Welcome'
            #------------------------- font-size
            font_style: "Welcome"
            role: "large"
            #------------------------- font-size
            halign: 'center'
            size_hint_y: None
            height: self.texture_size[1] - dp(30) # padding_y


       
#--------------------------------------------------------------------- field user
        MDTextField:
            id: user
            size_hint_x: None
            width: 200
            font_size: 18
            pos_hint: {"center_x": 0.5}

            theme_line_color: "Custom"
            line_color_normal: get_color_from_hex("#f1ecec")
            line_color_focus: get_color_from_hex("#ecd553")


            MDTextFieldHintText:
                text: "Username"
                text_color_normal: get_color_from_hex("#f1ecec")
                text_color_focus: get_color_from_hex("#ecd553")

            
            MDTextFieldTrailingIcon:
                icon: "account"
                theme_icon_color: "Custom"
                icon_color_normal: get_color_from_hex("#f1ecec")
                icon_color_focus: get_color_from_hex("#ecd553")
#--------------------------------------------------------------------- field password
        MDTextField:
            id: pasword
            size_hint_x: None
            width: 200
            font_size: 18
            pos_hint: {"center_x": 0.5}
            password: True

            theme_line_color: "Custom"
            line_color_normal: get_color_from_hex("#f1ecec")
            line_color_focus: get_color_from_hex("#ecd553")


            MDTextFieldHintText:
                text: "Password"
                text_color_normal: get_color_from_hex("#f1ecec")
                text_color_focus: get_color_from_hex("#ecd553")

            
            MDTextFieldTrailingIcon:
                icon: "eye-off"
                theme_icon_color: "Custom"
                icon_color_normal: get_color_from_hex("#f1ecec")
                icon_color_focus: get_color_from_hex("#ecd553")                     

#----------------------------------------------------------------------- Button Login
        MDButton:
            on_press: app.logger()
            style: "filled"
            font_size: 12

            theme_width: "Custom"
            size_hint_x: None
            width: dp(200)

            pos_hint: {"center_x": 0.5}
            radius: [dp(10), dp(10), dp(10), dp(10)]

            theme_bg_color: "Custom"
            # Колір 1 — звичайний стан
            md_bg_color: get_color_from_hex("#ecd553")

            # Колір 2 — курсор наведений
            on_enter: self.md_bg_color = get_color_from_hex("#e45f12")

            # Колір 1 — курсор пішов
            on_leave: self.md_bg_color = get_color_from_hex("#ecd553")

            # Колір 3 — натискання
            on_press: self.md_bg_color = get_color_from_hex("#09ecb3")

            # Після натискання — колір наведення або звичайний
            on_release: self.md_bg_color = get_color_from_hex("#09ec7b") if self.hovering else get_color_from_hex("#05f3d3")


            MDButtonText:
                text: "LOG In"

#----------------------------------------------------------------------- Button Clear
        MDButton:
            on_press: app.clear()

            style: "filled"
            font_size: 12
            
            theme_width: "Custom"
            size_hint_x: None
            width: dp(200)

            pos_hint: {"center_x": 0.5}
            
            radius: [dp(10), dp(10), dp(10), dp(10)]

            theme_bg_color: "Custom"
            # Колір 1 — звичайний стан
            md_bg_color: get_color_from_hex("#aaec53")

            # Колір 2 — курсор наведений
            on_enter: self.md_bg_color = get_color_from_hex("#12e4c1")

            # Колір 1 — курсор пішов
            on_leave: self.md_bg_color = get_color_from_hex("#aaec53")

            # Колір 3 — натискання
            on_press: self.md_bg_color = get_color_from_hex("#772808")

            # Після натискання — колір наведення або звичайний
            on_release: self.md_bg_color = get_color_from_hex("#195236") if self.hovering else get_color_from_hex("#195236")


            MDButtonText:
                text: "Clear"            

        
        Widget:
            size_hint_y: None
            height: 10
