#:import get_color_from_hex kivy.utils.get_color_from_hex
ScrollView:
    MDList:
        
        MDListItem:
            # id: item1
            on_release: app.presser(self,"item_1_text")
            MDListItemHeadlineText:
                # id: item_1_text
                text: "Some text list 1"

            MDListItemSupportingText:
                id: item_1_text
                text: "Supporting text for list 1"

    
        MDListItem:
            # id: item2
            on_release: app.presser(self,"item_2_text")
            MDListItemHeadlineText:
                # id: item_2_text
                text: "Some text list 2"

            MDListItemSupportingText:
                id: item_2_text
                text: "Supporting text for list 2"    


