#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import dp kivy.metrics.dp
#:import dp kivy.metrics.dp

MDFloatLayout:
    BoxLayout:
        orientation: 'vertical'
        size: root.width, root.height 

        Label:
            id: word_label
            text_size: self.size
            halign: 'center'
            valign: 'middle'
            text: 'Click the Button To Close The App'
            font_size: 32
        
        Button:
            size_hint: (1, 0.5)
            font_size: 32
            text: 'Close App'
            on_press: app.stop()            

                 

