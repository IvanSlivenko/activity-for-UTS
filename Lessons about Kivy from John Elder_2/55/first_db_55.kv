#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import dp kivy.metrics.dp
#:import dp kivy.metrics.dp

MDFloatLayout:
    BoxLayout:
        orientation: 'vertical'
        size: root.width, root.height 

        Label:
            id: word_label
            text_size: self.size
            halign: 'center'
            valign: 'middle'
            text: 'Enter a Name'
            font_size: 32
        TextInput:
            id: word_input
            multiline: False
            size_hint: (1, 0.5)

        Button:
            size_hint: (1, 0.5)
            font_size: 32
            text: 'Submit Name'
            on_press: app.submit()

        Button:
            size_hint: (1, 0.5)
            font_size: 32
            text: 'Show Records'
            on_press: app.show_records()        

