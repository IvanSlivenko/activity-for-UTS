<MyLayout>

    BoxLayout:
        #orientation: "horizontal"
        orientation: "vertical"
        size: root.width, root.height

        padding: 50
        spacing: 20

        Button:
            text: "Hello"


        RoundetButton:
            text: "Goodbye"
            pos_hint: {'center_x': 0.5}
            size_hint: (1, 0.3)
            #background_color: (48/255,84/255,150/255,1)
            #background_normal: ''
            on_press: print("Goodbye")


#-------------------------------------------------------------
<RoundetButton@Button>
    background_color: (0,0,0,0)
    background_normal: ''
    canvas.before:
        Color:
            rgba: (48/255,84/255,150/255,1)
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [50]

#--------------------------------------------------------------











