#:import get_color_from_hex kivy.utils.get_color_from_hex



MDBoxLayout:
    orientation: "vertical"
    theme_bg_color: "Custom"
    md_bg_color: get_color_from_hex("#464646")

    MDTopAppBar:
        type: "small"
        theme_bg_color: "Custom"
        md_bg_color: get_color_from_hex("#716c75")

        MDTopAppBarLeadingButtonContainer:
            MDActionTopAppBarButton:
                icon: "menu"

        MDTopAppBarTitle:
            text: "Our Top Toolbar"

        MDTopAppBarTrailingButtonContainer:
            MDActionTopAppBarButton:
                icon: "dots-vertical"

    MDLabel:
        id: my_label
        text: "Some stuff"
        halign: "center"

    Widget:
        size_hint_y: 1


        
    FloatLayout:
        size_hint_y: None
        height: dp(100)

        MDBottomAppBar:
            
            size_hint_y: None
            height: dp(56)
            pos_hint: {"x": 0, "y": 0}
            theme_bg_color: "Custom"
            md_bg_color: get_color_from_hex("#716c75")

        MDTopAppBarLeadingButtonContainer:
            MDActionTopAppBarButton:
                icon: "menu"
                pos_hint: {"x": 0.05, "center_y": 0.27}
                on_release: app.presser_bottom_title()

        MDLabel:
            text: "Bottom menu"
            theme_text_color: "Custom"
            text_color: get_color_from_hex("#FFFFFF")
            size_hint: None, None
            size: dp(120), dp(40)
            pos_hint: {"x": 0.07, "center_y": 0.25}

        MDActionBottomAppBarButton:
            icon: "git"
            pos_hint: {"right": 0.95, "center_y": 0.5}
            theme_bg_color: "Custom"
            md_bg_color: get_color_from_hex("#201e22")

            #Click the button
            on_release: app.presser()



        
            
            
            
