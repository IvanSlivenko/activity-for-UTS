#:import get_color_from_hex kivy.utils.get_color_from_hex

MDFloatLayout:
    MDButton:
        style: "outlined"
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        on_release: 
                for i in app.our_list: \
            our_label.text = our_label.text \
            + "\n" +i
       
                

        MDButtonText:
            text: app.some_text
            theme_text_color: "Custom"
            text_color: get_color_from_hex("#00CED1")

    MDLabel:
        id: our_label
        text: "Hello"
        theme_text_color: "Custom"
        text_color: get_color_from_hex("#FF1493")
        pos_hint: {'center_x': 0.95, 'center_y': 0.4}  
